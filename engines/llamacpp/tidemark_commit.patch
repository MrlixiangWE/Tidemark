             {"prompt",        prompt_tokens.detokenize(ctx, true)},
             {"next_token",
@@ -2588,6 +2599,25 @@ struct server_context {

         res->verbose        = slot.params.verbose;
         res->stream         = slot.params.stream;
         res->include_usage  = slot.params.include_usage;
         res->oaicompat      = slot.params.oaicompat;
+
+        // Tidemark: commit accounting for background prefill. Reported for
+        // every completion so foreground requests can update the catalog too.
+        {
+            const size_t n_resident = slot.cache_tokens.size();
+            res->tidemark_commit = json {
+                {"tokens_cached",    slot.n_prompt_tokens_cache},
+                {"tokens_evaluated", slot.n_prompt_tokens_processed},
+                {"prefix_hash",      tidemark_prefix_hash(slot.cache_tokens.get_text_tokens(), n_resident)},
+                {"slot",             slot.id},
+            };
+        }

         // populate res.probs_output
         if (slot.params.sampling.n_probs > 0) {
@@ -3286,6 +3316,23 @@ struct server_context {

                     slot.n_prompt_tokens_processed += n_batch_tokens;
                 }

+                // Tidemark: for a prefill-only slot, finish as soon as the
+                // whole prompt is resident. No sampling, no output tokens.
+                if (slot.is_prefill_only() && slot.n_prompt_tokens_processed >= slot.n_prompt_tokens) {
+                    SLT_INF(slot, "prefill-only request complete, n_cached = %d, n_eval = %d\n",
+                            slot.n_prompt_tokens_cache, slot.n_prompt_tokens_processed);
+                    slot.stop = STOP_TYPE_LIMIT;
+                    slot.has_next_token = false;
+                    slot.release();
+                    send_final_response(slot);
+                    continue;
+                }
+
                 // entire prompt has been processed
                 if (slot.n_past == slot.n_prompt_tokens) {
                     slot.state = SLOT_STATE_DONE_PROMPT;
@@ -3901,6 +3948,13 @@ int main(int argc, char ** argv) {
                 if (data.contains("prompt")) {
                     tokenized_prompts = tokenize_input_prompts(ctx_server.vocab, data.at("prompt"), true, true);
                 }
+                // Tidemark: n_predict == 0 is a prompt-only request, not an
+                // unbounded generation. Force the prompt to stay in the slot.
+                if (json_value(data, "n_predict", -1) == 0) {
+                    data["cache_prompt"] = true;
+                    data["n_keep"] = -1;
+                }
                 tasks.reserve(tokenized_prompts.size());
                 for (size_t i = 0; i < tokenized_prompts.size(); i++) {
                     server_task task = server_task(type);
