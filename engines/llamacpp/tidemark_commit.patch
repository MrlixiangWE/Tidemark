From: The Tidemark Authors
Subject: [PATCH] server: prefill-only requests and commit accounting for Tidemark

Accept n_predict == 0 as a prompt-only request, and attach a tidemark_commit
block to the completion response with the cached token count and a hash of
the slot's resident prefix. Also expose prompt_tokens on /slots.

---
 tools/server/server.cpp | 58 +++++++++++++++++++++++++++++++++++++++--
 tools/server/utils.hpp  | 21 ++++++++++++++
 2 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/tools/server/utils.hpp b/tools/server/utils.hpp
--- a/tools/server/utils.hpp
+++ b/tools/server/utils.hpp
@@ -32,6 +32,27 @@

 using json = nlohmann::ordered_json;

+// Tidemark: BLAKE2b-128 over little-endian int32 token ids, matching
+// tidemark.catalog.history.content_hash on the scheduler side.
+#include <sodium/crypto_generichash_blake2b.h>
+
+static std::string tidemark_prefix_hash(const llama_tokens & toks, size_t n) {
+    unsigned char out[16];
+    crypto_generichash_blake2b_state st;
+    crypto_generichash_blake2b_init(&st, nullptr, 0, sizeof(out));
+    for (size_t i = 0; i < n && i < toks.size(); ++i) {
+        uint32_t v = (uint32_t) toks[i];
+        unsigned char le[4] = {(unsigned char)(v), (unsigned char)(v >> 8),
+                               (unsigned char)(v >> 16), (unsigned char)(v >> 24)};
+        crypto_generichash_blake2b_update(&st, le, 4);
+    }
+    crypto_generichash_blake2b_final(&st, out, sizeof(out));
+    static const char * hex = "0123456789abcdef";
+    std::string s; s.reserve(32);
+    for (unsigned char c : out) { s.push_back(hex[c >> 4]); s.push_back(hex[c & 15]); }
+    return s;
+}
+
 template <typename T>
 static T json_value(const json & body, const std::string & key, const T & default_value) {
     // Fallback null to default value
