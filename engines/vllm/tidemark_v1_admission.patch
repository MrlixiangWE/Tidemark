@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bridge between vLLM's V1 scheduler and Tidemark's engine-local admission.
+
+Everything that knows about Tidemark's data structures lives in the
+``tidemark`` package; this file only converts vLLM objects into the plain
+numbers the shim wants and posts ticket results back to the scheduler process.
+"""
+from __future__ import annotations
+
+import json
+import os
+import socket
+import threading
+import urllib.request
+from dataclasses import asdict
+from typing import Optional
+
+from tidemark.admission.commit import CommitPath
+from tidemark.admission.controller import EngineLocalAdmission
+from tidemark.admission.guard import TpotGuard
+from tidemark.engines.vllm.shim import SchedulerStepStats, VllmAdmissionShim
+from tidemark.scheduler.ticket import AtomicTicket, TicketResult
+from vllm.v1.request import Request
+
+
+def is_background(request: Request) -> bool:
+    extra = getattr(request, "extra_args", None) or {}
+    return bool(extra.get("tidemark", {}).get("tidemark_ticket"))
+
+
+class TidemarkBridge:
+
+    def __init__(self, engine_id: str, scheduler_url: str, *, block_size: int,
+                 gamma: float, intervals: tuple[int, ...], kv_headroom: float,
+                 step_log: Optional[str]) -> None:
+        self.scheduler_url = scheduler_url.rstrip("/")
+        self.block_size = block_size
+        admission = EngineLocalAdmission(intervals=intervals,
+                                         kv_headroom=kv_headroom,
+                                         guard=TpotGuard(gamma=gamma))
+        self.shim = VllmAdmissionShim(engine_id, CommitPath(engine_id, self._post), admission)
+        self._tickets: dict[str, AtomicTicket] = {}
+        self.safe_budget_tokens = 0
+        if step_log:
+            fh = open(step_log, "a", buffering=1)
+            self.shim.step_log = lambda row: fh.write(json.dumps(row) + "\n")
+
+    @classmethod
+    def from_env(cls, *, block_size: int, model_id: str) -> "TidemarkBridge":
+        intervals = tuple(int(x) for x in os.getenv("TIDEMARK_INTERVALS", "256,512,1024").split(","))
+        return cls(
+            engine_id=os.getenv("TIDEMARK_ENGINE_ID", socket.gethostname()),
+            scheduler_url=os.environ["TIDEMARK_SCHEDULER"],
+            block_size=block_size,
+            gamma=float(os.getenv("TIDEMARK_GAMMA", "0.03")),
+            intervals=intervals,
+            kv_headroom=float(os.getenv("TIDEMARK_KV_HEADROOM", "0.08")),
+            step_log=os.getenv("TIDEMARK_STEP_LOG"),
+        )
+
+    # ---- request lifecycle -------------------------------------------------
+    def enqueue(self, request: Request) -> None:
+        meta = request.extra_args["tidemark"]
+        ticket = AtomicTicket.from_metadata(meta, request.prompt_token_ids)
+        self._tickets[request.request_id] = ticket
+        self.shim.enqueue(ticket, request.request_id)
+
+    def forget(self, request_id: str) -> None:
+        self._tickets.pop(request_id, None)
+
+    # ---- step hooks --------------------------------------------------------
+    def begin_step(self, **kw) -> "TidemarkBridge":
+        stats = SchedulerStepStats(block_size=self.block_size, max_num_batched_tokens=kw.pop("token_budget"),
+                                   scheduled_decode_tokens=kw.pop("decode_tokens"),
+                                   scheduled_prefill_tokens=kw.pop("prefill_tokens"), **kw)
+        step = self.shim.begin_step(stats)
+        _, self.safe_budget_tokens = self.shim.admission.observe(step)
+        return self
+
+    def size_background(self, request_id: str) -> int:
+        return self.shim.size_background(request_id)
+
+    def after_schedule(self, scheduled: dict[str, int]) -> None:
+        for rid, n in scheduled.items():
+            self.shim.account(rid, n, 0.0)
+
+    def end_step(self, finished, preempted, step_ms: Optional[float]) -> None:
+        self.shim.end_step(finished, preempted)
+
+    # ---- results -----------------------------------------------------------
+    def _post(self, result: TicketResult) -> None:
+        body = json.dumps({**asdict(result), "status": result.status.value}).encode()
+        req = urllib.request.Request(f"{self.scheduler_url}/v1/tickets/result", data=body,
+                                     headers={"Content-Type": "application/json"}, method="POST")
+        threading.Thread(target=lambda: urllib.request.urlopen(req, timeout=2), daemon=True).start()
